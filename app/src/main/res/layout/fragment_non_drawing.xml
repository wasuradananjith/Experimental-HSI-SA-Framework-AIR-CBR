<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="@dimen/_220sdp"
    tools:context=".NonDrawingFragment">

    <TextView
        android:id="@+id/questionTxt"
        android:layout_width="@dimen/_380sdp"
        android:layout_height="@dimen/_30sdp"
        android:ellipsize="end"
        android:maxLines="3"
        android:text="question content?"
        android:textSize="@dimen/_10sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.235"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.145" />

    <TextView
        android:id="@+id/questionNo"
        android:layout_width="@dimen/_150sdp"
        android:layout_height="@dimen/_10sdp"
        android:text="Question No"
        android:textSize="@dimen/_7sdp"
        app:layout_constraintBottom_toTopOf="@+id/questionTxt"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.039"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.773" />

    <RadioGroup
        android:id="@+id/radioGroup"
        android:layout_width="889dp"
        android:layout_height="295dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.218"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/questionTxt"
        app:layout_constraintVertical_bias="0.297">

        <RadioButton
            android:id="@+id/answer1"
            android:layout_width="@dimen/_300sdp"
            android:layout_height="wrap_content"
            android:layout_gravity="left"
            android:checked="false"
            android:padding="@dimen/_2sdp"
            android:text="Answer 1"
            android:textSize="@dimen/_10sdp" />

        <RadioButton
            android:id="@+id/answer2"
            android:layout_width="@dimen/_300sdp"
            android:layout_height="wrap_content"
            android:layout_gravity="left"
            android:checked="false"
            android:padding="@dimen/_2sdp"
            android:text="Answer 2"
            android:textSize="@dimen/_10sdp" />

        <RadioButton
            android:id="@+id/answer3"
            android:layout_width="@dimen/_300sdp"
            android:layout_height="wrap_content"
            android:layout_gravity="left"
            android:checked="false"
            android:padding="@dimen/_2sdp"
            android:text="Answer 3"
            android:textSize="@dimen/_10sdp" />

        <RadioButton
            android:id="@+id/answer4"
            android:layout_width="@dimen/_300sdp"
            android:layout_height="wrap_content"
            android:layout_gravity="left"
            android:checked="false"
            android:padding="@dimen/_2sdp"
            android:text="Answer 4"
            android:textSize="@dimen/_10sdp" />

    </RadioGroup>

</androidx.constraintlayout.widget.ConstraintLayout>